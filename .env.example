EMAILJS_SERVICE_ID=your_service_id
EMAILJS_TEMPLATE_ID=your_template_id
EMAILJS_CONFIRMATION_TEMPLATE_ID=your_confirmation_template_id_optional
EMAILJS_PUBLIC_KEY=your_public_key
EMAILJS_PRIVATE_KEY=your_private_key_optional

# Postgres dei lead. In locale basta DATABASE_URL; su Coolify va bene lo stesso
# nome, il codice legge process.env direttamente (vedi server/utils/db.ts).
DATABASE_URL=postgres://user:password@host:port/dbname

# Webhook n8n di ingresso lead, piu' il token che n8n verifica in Header Auth
N8N_WEBHOOK_URL=https://n8n.example.com/webhook/lead-nuovo
N8N_WEBHOOK_TOKEN=un_segreto_lungo_generato_a_caso

# Token che protegge gli endpoint di cambio stato del lead
LEAD_ACTION_TOKEN=un_altro_segreto_lungo_generato_a_caso
